---
// Intended data flow of the optimization tool. Describes the design, not a validated result.
const steps = [
  { name: 'Generate', text: 'Cold plate geometry: organic, or a family such as pin fin, straight channel, or gyroid.' },
  { name: 'Simulate', text: 'OpenFOAM CFD on each candidate.' },
  { name: 'Optimize', text: 'Pareto front across temperature and pressure drop.' },
  { name: 'Output', text: 'Three designs: temperature-optimized, pressure-optimized, and balanced.' },
];
---

<figure class="pl">
  <ol class="pl__steps">
    {
      steps.map((s) => (
        <li>
          <strong>{s.name}.</strong> {s.text}
        </li>
      ))
    }
  </ol>
  <figcaption>Intended pipeline. The tool is in development.</figcaption>
</figure>

<style>
  .pl {
    margin: 2rem 0;
  }

  .pl__steps {
    display: grid;
    gap: 0.45rem;
    max-width: var(--measure);
    padding-left: 1.3rem;
    list-style: decimal;
  }

  .pl__steps li::marker {
    color: var(--fg-muted);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
</style>
