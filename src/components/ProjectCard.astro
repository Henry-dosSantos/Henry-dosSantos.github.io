---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { findImage } from '../lib/images';

interface Props {
  entry: CollectionEntry<'projects'>;
  index: number;
}

const { entry, index } = Astro.props;
const { data, id } = entry;
// Optional cover: src/assets/projects/<id>/cover.(jpg|png|webp). Cards render without one.
const cover = findImage(`${id}/cover`);
const n = String(index + 1).padStart(2, '0');
const metrics = data.metrics.slice(0, data.flagship ? 4 : 3);
---

<article class:list={['card', 'pc', 'reveal', data.flagship && 'pc--flag', cover && 'pc--cover']}>
  <span class="card__line" aria-hidden="true"></span>
  <div class="pc__body">
    <div class="pc__top">
      <span class="mono pc__n">{n}</span>
      <span class={`badge badge--${data.status}`}>{data.statusLabel}</span>
    </div>
    <h3 class="pc__title" style={`view-transition-name:title-${id}`}>
      <a class="stretch" href={`/projects/${id}/`}>{data.title}</a>
    </h3>
    <p class="mono pc__ctx">{data.context}</p>
    <p class="pc__sum">{data.summary}</p>
    {
      metrics.length > 0 && (
        <dl class="pc__metrics">
          {metrics.map((m) => (
            <div>
              <dd class="num">
                {m.value}
                {m.unit && <span>{m.unit}</span>}
              </dd>
              <dt>{m.label}</dt>
            </div>
          ))}
        </dl>
      )
    }
    <div class="pc__foot">
      <ul class="chips" aria-label="Tools">
        {data.tools.slice(0, 5).map((t) => <li class="chip">{t}</li>)}
      </ul>
      <span class="pc__more" aria-hidden="true">Write-up <span class="arrow">&rarr;</span></span>
    </div>
  </div>
  {
    cover && (
      <div class="pc__img">
        <Image src={cover} alt="" widths={[480, 800, 1200]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" />
      </div>
    )
  }
</article>

<style>
  .pc__body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
    padding: clamp(1.4rem, 3vw, 2.1rem);
  }

  .pc__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pc__n {
    color: var(--gold);
    font-size: 0.8125rem;
  }

  .pc__title {
    font-size: clamp(1.35rem, 2.4vw, 1.7rem);
    margin-top: 0.4rem;
    width: fit-content;
  }

  .pc__title a {
    text-decoration: none;
  }

  .pc__ctx {
    color: var(--muted);
    font-size: 0.6875rem;
  }

  .pc__sum {
    color: #c9d6e3;
    max-width: 62ch;
  }

  .pc__metrics {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: 0.9rem;
    margin: 0.4rem 0 0.2rem;
    border-top: 1px solid var(--line);
  }

  .pc__metrics div {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .pc__metrics dd {
    margin: 0;
    font-size: 1.3rem;
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--gold-light);
    white-space: nowrap;
  }

  .pc__metrics dd span {
    margin-left: 0.3em;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .pc__metrics dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--muted);
  }

  .pc__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .pc__more {
    font-weight: 650;
    font-size: 0.9rem;
    color: var(--gold-light);
    white-space: nowrap;
  }

  .pc__img {
    border-top: 1px solid var(--line);
  }

  .pc__img img {
    width: 100%;
    height: 100%;
    max-height: 22rem;
    object-fit: cover;
  }

  .pc--flag .pc__title {
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    font-stretch: 118%;
  }

  @media (min-width: 900px) {
    .pc--flag .pc__metrics {
      grid-template-columns: repeat(4, 1fr);
      border-bottom: 1px solid var(--line);
    }

    .pc--flag .pc__metrics div {
      display: block;
      padding: 1rem 1rem 0.9rem 0;
      border-bottom: 0;
    }

    .pc--flag .pc__metrics dd {
      font-size: clamp(1.4rem, 2.2vw, 1.85rem);
    }

    .pc--flag .pc__metrics dt {
      margin-top: 0.35rem;
    }
  }

  @media (min-width: 900px) {
    .pc--flag.pc--cover {
      flex-direction: row;
    }

    .pc--flag.pc--cover .pc__img {
      flex: 0 0 42%;
      border-top: 0;
      border-left: 1px solid var(--line);
    }

    .pc--flag.pc--cover .pc__img img {
      max-height: none;
    }
  }
</style>
