---
// Four channel topologies compared on the testbed. Sketches are generic, not the CAD.
const pins: [number, number][] = [];
for (let r = 0; r < 5; r++) for (let c = 0; c < 9; c++) pins.push([22 + c * 14.5 + (r % 2 ? 7.25 : 0), 18 + r * 11]);

const items = [
  { id: 'straight', name: 'Straight', tested: true },
  { id: 'serpentine', name: 'Serpentine', tested: false },
  { id: 'dense', name: 'High-density multi-channel', tested: false },
  { id: 'pin', name: 'Pin-fin', tested: false },
];
---

<figure class="geo">
  <ul class="geo__grid">
    {
      items.map((g) => (
        <li class:list={['geo__item', g.tested && 'geo__item--on']}>
          <svg viewBox="0 0 160 80" aria-hidden="true">
            <rect x="4" y="4" width="152" height="72" rx="4" fill="none" stroke="currentColor" stroke-opacity="0.35" />
            {g.id === 'straight' && [18, 29, 40, 51, 62].map((y) => <line x1="18" y1={y} x2="142" y2={y} stroke="currentColor" stroke-width="3" stroke-linecap="round" />)}
            {g.id === 'serpentine' && <path d="M18 18H136a6 6 0 0 1 0 12H24a6 6 0 0 0 0 12H136a6 6 0 0 1 0 12H24a6 6 0 0 0 0 10H142" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" />}
            {g.id === 'dense' && [14, 19.8, 25.6, 31.4, 37.2, 43, 48.8, 54.6, 60.4, 66.2].map((y) => <line x1="18" y1={y} x2="142" y2={y} stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />)}
            {g.id === 'pin' && pins.map(([x, y]) => <circle cx={x} cy={y} r="2.6" fill="currentColor" />)}
          </svg>
          <p class="geo__name">{g.name}</p>
          <p class="geo__state">{g.tested ? 'Tested (baseline)' : 'Designed, not yet tested'}</p>
        </li>
      ))
    }
  </ul>
  <figcaption>Topology sketches for orientation only. They are not the CAD geometry.</figcaption>
</figure>

<style>
  .geo {
    margin: 2rem 0;
  }

  .geo__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.5rem;
  }

  .geo__item {
    color: var(--fg-muted);
  }

  .geo__item--on {
    color: var(--fg);
  }

  .geo__item svg {
    width: 100%;
    height: auto;
  }

  .geo__item:not(.geo__item--on) svg {
    opacity: 0.6;
  }

  .geo__name {
    margin-top: 0.7rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--fg);
  }

  .geo__state {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
</style>
