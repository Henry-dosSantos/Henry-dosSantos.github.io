---
interface Props {
  items: { value: string; unit?: string; label: string }[];
  caption?: string;
  label?: string;
}

const { items, caption, label } = Astro.props;
---

<table class="mt" aria-label={label}>
  {caption && <caption>{caption}</caption>}
  <tbody>
    {
      items.map((m) => (
        <tr>
          <th scope="row">
            {m.value}
            {m.unit && <span class="mt__unit">{m.unit}</span>}
          </th>
          <td>{m.label}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .mt {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums lining-nums;
  }

  caption {
    padding-bottom: 0.6rem;
    text-align: left;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--fg);
  }

  tbody tr {
    border-bottom: 1px solid var(--line);
  }

  tbody tr:first-child {
    border-top: 1px solid var(--line-strong);
  }

  th,
  td {
    padding: 0.75rem 0;
    vertical-align: baseline;
    text-align: left;
  }

  th {
    width: 1%;
    padding-right: 1.5rem;
    font-size: 1.2rem;
    font-weight: 750;
    font-stretch: 110%;
    white-space: nowrap;
    color: var(--fg);
  }

  .mt__unit {
    margin-left: 0.3em;
    font-size: 0.875rem;
    font-weight: 400;
    font-stretch: 100%;
    color: var(--fg-muted);
  }

  td {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }
</style>
