---
// Hero figure: top-view schematic of the straight-channel baseline.
// The drawing is generic and not to scale. The numbers in the legend are measured or as-built values.
const channels = Array.from({ length: 9 }, (_, i) => 80 + i * 30);
---

<figure class="sch">
  <svg class="sch__svg" viewBox="0 0 600 400" role="img" aria-labelledby="sch-title sch-desc">
    <title id="sch-title">Schematic of a nine-channel straight cold plate</title>
    <desc id="sch-desc">
      Coolant enters an inlet manifold on the left, splits across nine parallel channels over a central heat
      source, and leaves through an outlet manifold on the right, warming from inlet to outlet.
    </desc>
    <defs>
      <linearGradient id="sch-flow" gradientUnits="userSpaceOnUse" x1="104" y1="0" x2="496" y2="0">
        <stop offset="0" stop-color="#5cd6f5"></stop>
        <stop offset="0.55" stop-color="#debd88"></stop>
        <stop offset="1" stop-color="#ff6a3d"></stop>
      </linearGradient>
    </defs>

    <rect x="20" y="30" width="560" height="340" rx="6" fill="#0a2847" stroke="#debd88" stroke-width="1.5"></rect>

    <rect x="70" y="62" width="34" height="276" rx="17" fill="#5cd6f5" fill-opacity="0.13" stroke="#5cd6f5" stroke-opacity="0.5"></rect>
    <rect x="496" y="62" width="34" height="276" rx="17" fill="#ff6a3d" fill-opacity="0.13" stroke="#ff6a3d" stroke-opacity="0.5"></rect>

    {
      channels.map((y, i) => (
        <g>
          <rect x="104" y={y - 7} width="392" height="14" fill="#e8eef5" fill-opacity="0.045"></rect>
          <line class="sch__dash" x1="108" y1={y} x2="492" y2={y} stroke="url(#sch-flow)" style={`animation-delay:-${(i * 0.19).toFixed(2)}s`}></line>
        </g>
      ))
    }

    <rect x="222" y="122" width="156" height="156" rx="6" fill="none" stroke="#ff6a3d" stroke-width="1.5" stroke-dasharray="7 6"></rect>

    <circle cx="87" cy="200" r="9" fill="#051e39" stroke="#5cd6f5" stroke-width="2"></circle>
    <circle cx="513" cy="200" r="9" fill="#051e39" stroke="#ff6a3d" stroke-width="2"></circle>

    <g class="sch__label">
      <text x="87" y="54" text-anchor="middle" fill="#5cd6f5">Inlet</text>
      <text x="513" y="54" text-anchor="middle" fill="#ff6a3d">Outlet</text>
      <text x="300" y="356" text-anchor="middle" fill="#ff6a3d">Heat source, 40 to 100 W</text>
    </g>
  </svg>
  <dl class="sch__legend">
    <div><dt>Base</dt><dd>C110 copper, 100 &times; 150 &times; 3 mm</dd></div>
    <div><dt>Channels</dt><dd>9 &times; (3 &times; 5 mm), D<sub>h</sub> = 3.75 mm</dd></div>
    <div><dt>Flow</dt><dd>&asymp; 840 mL/min, Re &asymp; 400 to 420, laminar</dd></div>
  </dl>
  <figcaption>
    Schematic of the straight-channel baseline, not to scale. The flow animation is illustrative, not CFD output.
    <button type="button" class="sch__pause" aria-pressed="false">Pause animation</button>
  </figcaption>
</figure>

<script>
  document.querySelectorAll<HTMLElement>('.sch').forEach((fig) => {
    const btn = fig.querySelector<HTMLButtonElement>('.sch__pause');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const paused = fig.toggleAttribute('data-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Play animation' : 'Pause animation';
    });
  });
</script>

<style>
  .sch {
    max-width: 34rem;
    margin: 0;
  }

  .sch__svg {
    width: 100%;
    height: auto;
  }

  .sch__dash {
    stroke-width: 3.2;
    stroke-linecap: round;
    stroke-dasharray: 14 26;
  }

  .sch__label {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
  }

  .sch__legend {
    margin: 0.75rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .sch__legend div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .sch__legend dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding-top: 0.1em;
  }

  .sch__legend dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .sch__pause {
    display: inline-block;
    min-height: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition:
      color var(--t-fast),
      text-decoration-color var(--t-fast);
  }

  .sch__pause:hover {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sch__dash {
      animation: sch-flow 1.5s linear infinite;
    }

    .sch[data-paused] .sch__dash {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sch__pause {
      display: none;
    }
  }

  @keyframes sch-flow {
    to {
      stroke-dashoffset: -40;
    }
  }
</style>
