---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Callout from '../../components/Callout.astro';
import Finding from '../../components/Finding.astro';
import FigureRow from '../../components/FigureRow.astro';
import Metrics from '../../components/Metrics.astro';
import { repoUrl } from '../../site.config.mjs';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { data, id } = entry;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const repo = repoUrl(data.repo);
const repoText = repo?.replace(/^https?:\/\//, '');
const meta = [
  { k: 'Status', v: data.statusLabel },
  { k: 'Context', v: data.context },
  { k: 'Period', v: data.period },
  ...(data.role ? [{ k: 'My role', v: data.role }] : []),
];
---

<Base title={data.shortTitle} description={data.summary}>
  <article>
    <header class="ph on-black">
      <div class="wrap">
        <nav class="ph__crumb" aria-label="Breadcrumb"><a href="/#projects">Projects</a></nav>
        <h1 class="ph__title" style={`view-transition-name:title-${id}`}>{data.title}</h1>
        <p class="ph__sum">{data.summary}</p>
        <dl class="ph__meta">
          {
            meta.map((m) => (
              <div>
                <dt>{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
          {
            data.tools.length > 0 && (
              <div class="ph__wide">
                <dt>Tools and methods</dt>
                <dd>{data.tools.join(', ')}</dd>
              </div>
            )
          }
          {
            repo && (
              <div class="ph__wide">
                <dt>Repository</dt>
                <dd>
                  <a href={repo} rel="noopener">{repoText}</a>
                </dd>
              </div>
            )
          }
        </dl>
        {
          data.metrics.length > 0 && (
            <div class="ph__metrics">
              <Metrics items={data.metrics} label="Key figures" />
            </div>
          )
        }
      </div>
    </header>

    <div class="wrap pb">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page">
            <p class="toc__h">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <Content components={{ Figure, FigureRow, Callout, Finding }} />
      </div>
    </div>

    <nav class="wrap pn" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}>Previous: {prev.data.shortTitle}</a> : <span />}
      {next && <a class="pn__next" href={`/projects/${next.id}/`}>Next: {next.data.shortTitle}</a>}
    </nav>
  </article>
</Base>

<style>
  .ph {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.25rem, 4vw, 3.25rem);
  }

  .ph__crumb {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .ph__title {
    max-width: 24ch;
    margin-top: 1.5rem;
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-weight: 800;
    font-stretch: 118%;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .ph__sum {
    max-width: 62ch;
    margin-top: 1.25rem;
    font-size: 1.2rem;
    line-height: 1.45;
    color: var(--fg);
  }

  .ph__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 1.1rem 2rem;
    margin: 2rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .ph__meta dt {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--fg-muted);
  }

  .ph__meta dd {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
  }

  .ph__wide {
    grid-column: 1 / -1;
  }

  .ph__wide dd {
    max-width: 70ch;
  }

  .ph__metrics {
    max-width: 44rem;
    margin-top: 2rem;
  }

  .pb {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 1080px) {
    .pb {
      grid-template-columns: 15rem minmax(0, 50rem);
    }

    .toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }

  .toc__h {
    margin-bottom: 0.7rem;
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--fg-muted);
  }

  .toc ol {
    display: grid;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 1rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.9375rem;
    line-height: 1.35;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--fg);
    border-left-color: var(--fg);
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 1.5rem 4rem;
    border-top: 1px solid var(--line);
    font-weight: 650;
  }

  .pn__next {
    grid-column: 2;
    text-align: right;
  }

  @media (max-width: 560px) {
    .pn {
      grid-template-columns: 1fr;
    }

    .pn__next {
      grid-column: 1;
      text-align: left;
    }

    .pn > span {
      display: none;
    }
  }
</style>
