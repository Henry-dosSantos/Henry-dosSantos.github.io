  name === 'linkedin' && (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path fill-rule="evenodd" d="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Zm1.6 6.6v8h2.5v-8H6.6Zm1.25-3.5a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9Zm3.05 3.5v8h2.5v-4.3c0-1.2.7-1.9 1.6-1.9s1.4.6 1.4 1.9v4.3h2.5v-4.9c0-2.2-1.2-3.3-2.9-3.3-1.1 0-2 .5-2.6 1.3V9.6h-2.5Z" />
    </svg>
