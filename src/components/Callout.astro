---
interface Props {
  // "limit" = open item or limitation, "hold" = withheld until a date, "note" = neutral.
  type?: 'note' | 'limit' | 'hold';
  title: string;
}

const { type = 'note', title } = Astro.props;
---

<aside class:list={['co', `co--${type}`]}>
  <p class="co__title">{title}</p>
  <div class="co__body"><slot /></div>
</aside>

<style>
  .co {
    max-width: var(--measure);
    margin: 2rem 0;
    padding: 1rem 1.25rem;
    border-radius: var(--r-sm);
    background: var(--tint);
  }

  .co--limit,
  .co--hold {
    background: var(--heat-tint);
  }

  .co__title {
    margin-bottom: 0.5rem;
    font-size: 1rem;
    font-weight: 750;
    color: var(--fg);
  }

  .co--limit .co__title,
  .co--hold .co__title {
    color: var(--heat);
  }

  .co__body :global(> * + *) {
    margin-top: 0.6rem;
  }

  .co__body :global(ul) {
    padding-left: 1.3rem;
    list-style: disc;
  }

  .co__body :global(ul li::marker) {
    color: var(--fg-muted);
  }
</style>
