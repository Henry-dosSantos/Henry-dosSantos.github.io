---
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';

interface Props {
  // "<project-id>/<file name without extension>". The file lives in src/assets/projects/.
  src: string;
  // Describes the image. Used as alt text, and as the placeholder text until the file exists.
  alt: string;
  caption?: string;
  // Placeholder label, e.g. "Photo", "Plot", "CAD render", "CFD result", "Test data".
  kind?: string;
  // Marks the slot as intentionally withheld. A string is shown as the reason.
  hold?: boolean | string;
}

const { src, alt, caption, kind = 'Photo', hold } = Astro.props;
const image = findImage(src);
---

<figure class:list={['fig', !image && 'fig--pending']}>
  {
    image ? (
      <>
        <Image src={image} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 900px) 800px, 100vw" loading="lazy" />
        {caption && <figcaption>{caption}</figcaption>}
      </>
    ) : (
      <p class="fig__ph">
        {hold ? (
          <>
            <strong class="fig__held">{kind} withheld.</strong> {alt}
            {typeof hold === 'string' && <> {hold}</>}
          </>
        ) : (
          <>
            <strong>{kind} pending.</strong> {alt}
          </>
        )}
        {import.meta.env.DEV && <code class="fig__path"> src/assets/projects/{src}.jpg</code>}
      </p>
    )
  }
</figure>

<style>
  .fig {
    margin: 2rem 0;
  }

  .fig--pending {
    margin: 1rem 0;
  }

  .fig :global(img) {
    width: 100%;
    border-radius: var(--r-sm);
  }

  .fig__ph {
    max-width: var(--measure);
    padding: 0.7rem 1rem;
    border-radius: var(--r-sm);
    background: var(--tint);
    font-size: 0.9375rem;
  }

  .fig__held {
    color: var(--heat);
  }

  .fig__path {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  figcaption {
    margin-top: 0.6rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
</style>
