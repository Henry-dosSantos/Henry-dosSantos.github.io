---
import { Image } from 'astro:assets';
import { findImage } from '../lib/images';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

const items = [
  { file: 'body-straight', name: 'Straight', state: 'Tested (baseline)' },
  { file: 'body-serpentine', name: 'Serpentine', state: 'Designed, not yet tested' },
  { file: 'body-high-density', name: 'High-density multi-channel', state: 'Designed, not yet tested' },
  { file: 'body-pin-fin', name: 'Pin-fin', state: 'Designed, not yet tested' },
].map((g) => ({ ...g, image: findImage(`cold-plate-testbed/${g.file}`) }));
---

<figure class:list={['geo', compact && 'geo--compact']}>
  <ul class="geo__grid">
    {
      items.map((g) => (
        <li class="geo__item">
          {g.image && (
            <Image
              src={g.image}
              alt={`CAD render of the ${g.name} channel body`}
              widths={[240, 451]}
              sizes="(min-width: 700px) 12rem, 45vw"
              loading="lazy"
            />
          )}
          <p class="geo__name">{g.name}</p>
          {!compact && <p class="geo__state">{g.state}</p>}
        </li>
      ))
    }
  </ul>
  {!compact && <figcaption>CAD renders of the four 3D-printed ASA channel bodies, channel side.</figcaption>}
</figure>

<style>
  .geo {
    margin: 2rem 0;
  }

  .geo--compact {
    margin: 1.5rem 0 0;
  }

  .geo__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (min-width: 560px) {
    .geo__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .geo--compact .geo__grid {
    gap: 0.75rem;
  }

  .geo__item img {
    width: 100%;
    border-radius: var(--r-sm);
  }

  .geo__name {
    margin-top: 0.6rem;
    font-weight: 650;
    line-height: 1.25;
    color: var(--fg);
  }

  .geo--compact .geo__name {
    margin-top: 0.4rem;
    font-size: 0.8125rem;
  }

  .geo__state {
    margin-top: 0.3rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
</style>
