---
// Hero figure: top-view schematic of the test loop. A canvas below the SVG draws the moving fluid,
// so every solid part is drawn opaque in the SVG and the cavities are left see-through.
import {
  BOLTS,
  BOLT_R,
  CH_X,
  DENSE_CH,
  GEO_IDS,
  GEO_LABELS,
  HEAT,
  HOLE_IN,
  HOLE_OUT,
  HOLE_R,
  INNER,
  LEGEND,
  MM,
  OX,
  OY,
  PINS,
  PIN_R,
  PLATE,
  PLENUM_IN,
  PLENUM_OUT,
  PORT_IN,
  PORT_OUT,
  PORT_R,
  PUMP,
  RAD,
  RES,
  SENSOR,
  SERP_D,
  SERP_W,
  STRAIGHT_CH,
  TUBE_BORE,
  TUBE_D,
  TUBE_W,
  ZONE,
} from '../lib/loopGeometry';

const plate = `translate(${OX} ${OY}) scale(${MM})`;
const sw = (v: number) => v / MM;
const finX = Array.from({ length: RAD.fins }, (_, i) => RAD.x - RAD.w / 2 + (RAD.w * (i + 1)) / (RAD.fins + 1));
---

<figure class="loop" data-geo="straight" data-view="full">
  <div class="loop__stage">
    <canvas class="loop__cv" aria-hidden="true"></canvas>
    <svg class="loop__svg" viewBox="0 0 720 500" role="img" aria-labelledby="loop-t loop-d">
      <title id="loop-t">Schematic of the cold plate test loop</title>
      <desc id="loop-d">
        Coolant flows from the reservoir through the pump and flow sensor into the cold plate inlet, across the
        channels over the heat source, out to the radiator, and back to the reservoir. Buttons below switch between
        the four channel bodies.
      </desc>
      <defs>
        {
          GEO_IDS.map((g) => (
            <mask id={`loop-m-${g}`} maskUnits="userSpaceOnUse" x="100" y="140" width="520" height="360">
              <rect x="100" y="140" width="520" height="360" fill="#fff" />
              <g transform={plate} fill="#000">
                <rect x={PLENUM_IN.x} y={PLENUM_IN.y} width={PLENUM_IN.w} height={PLENUM_IN.h} rx={PLENUM_IN.r} />
                <rect x={PLENUM_OUT.x} y={PLENUM_OUT.y} width={PLENUM_OUT.w} height={PLENUM_OUT.h} rx={PLENUM_OUT.r} />
                {g === 'straight' &&
                  STRAIGHT_CH.map((c) => <rect x={CH_X.x} y={c.y} width={CH_X.w} height={c.h} />)}
                {g === 'dense' && DENSE_CH.map((c) => <rect x={CH_X.x} y={c.y} width={CH_X.w} height={c.h} />)}
                {g === 'serpentine' && (
                  <path d={SERP_D} fill="none" stroke="#000" stroke-width={SERP_W} stroke-linejoin="round" />
                )}
                {g === 'pin' && (
                  <>
                    <rect x={ZONE.x0} y={ZONE.y0} width={ZONE.x1 - ZONE.x0} height={ZONE.y1 - ZONE.y0} />
                    {PINS.map(([x, y]) => (
                      <circle cx={x} cy={y} r={PIN_R} fill="#fff" />
                    ))}
                  </>
                )}
              </g>
              <path d={TUBE_D} fill="none" stroke="#000" stroke-width={TUBE_BORE} />
            </mask>
          ))
        }
        <mask id="loop-tube-m" maskUnits="userSpaceOnUse" x="0" y="0" width="720" height="500">
          <rect x="0" y="0" width="720" height="500" fill="#fff"></rect>
          <path d={TUBE_D} fill="none" stroke="#000" stroke-width={TUBE_BORE}></path>
        </mask>
      </defs>

      {
        GEO_IDS.map((g) => (
          <g class="loop__body" data-body={g} mask={`url(#loop-m-${g})`}>
            <g transform={plate}>
              <rect width={PLATE.w} height={PLATE.h} rx={PLATE.r} fill="#1c1c1c" stroke="#debd88" stroke-width={sw(1.5)} />
            </g>
          </g>
        ))
      }

      <g transform={plate}>
        <rect x={INNER.x} y={INNER.y} width={INNER.w} height={INNER.h} fill="none" stroke="rgb(255 255 255 / 0.16)" stroke-width={sw(1)}></rect>
        {BOLTS.map(([x, y]) => <circle cx={x} cy={y} r={BOLT_R} fill="#000"></circle>)}
        <circle cx={PORT_IN.x} cy={PORT_IN.y} r={PORT_R} fill="none" stroke="#debd88" stroke-width={sw(1.5)}></circle>
        <circle cx={PORT_OUT.x} cy={PORT_OUT.y} r={PORT_R} fill="none" stroke="#debd88" stroke-width={sw(1.5)}></circle>
        <circle cx={HOLE_IN.x} cy={HOLE_IN.y} r={HOLE_R} fill="none" stroke="rgb(255 255 255 / 0.4)" stroke-width={sw(1)}></circle>
        <circle cx={HOLE_OUT.x} cy={HOLE_OUT.y} r={HOLE_R} fill="none" stroke="rgb(255 255 255 / 0.4)" stroke-width={sw(1)}></circle>
        <rect x={HEAT.x} y={HEAT.y} width={HEAT.w} height={HEAT.h} fill="none" stroke="#ff6a3d" stroke-width={sw(1.5)} stroke-dasharray={`${sw(7)} ${sw(6)}`}></rect>
      </g>

      <path d={TUBE_D} fill="none" stroke="#debd88" stroke-width={TUBE_W} mask="url(#loop-tube-m)"></path>

      <rect x={RAD.x - RAD.w / 2} y={RAD.y - RAD.h / 2} width={RAD.w} height={RAD.h} fill="none" stroke="#debd88" stroke-width="1.5"></rect>
      {finX.map((x) => <line x1={x} y1={RAD.y - RAD.h / 2} x2={x} y2={RAD.y + RAD.h / 2} stroke="rgb(222 189 136 / 0.45)" stroke-width="1"></line>)}

      <rect x={RES.x - RES.w / 2} y={RES.y - RES.h / 2} width={RES.w} height={RES.h} fill="#1c1c1c" stroke="#debd88" stroke-width="1.5"></rect>
      <line x1={RES.x - RES.w / 2} y1={RES.y - RES.h / 2 + 14} x2={RES.x + RES.w / 2} y2={RES.y - RES.h / 2 + 14} stroke="rgb(255 255 255 / 0.5)" stroke-width="1"></line>

      <circle cx={PUMP.x} cy={PUMP.y} r={PUMP.r} fill="#1c1c1c" stroke="#debd88" stroke-width="1.5"></circle>
      <polygon points={`${PUMP.x - 12},${PUMP.y} ${PUMP.x + 8},${PUMP.y - 11} ${PUMP.x + 8},${PUMP.y + 11}`} fill="none" stroke="#debd88" stroke-width="1.5" stroke-linejoin="round"></polygon>

      <circle cx={SENSOR.x} cy={SENSOR.y} r={SENSOR.r} fill="#1c1c1c" stroke="#debd88" stroke-width="1.5"></circle>
      <line x1={SENSOR.x - 10} y1={SENSOR.y} x2={SENSOR.x + 10} y2={SENSOR.y} stroke="#debd88" stroke-width="1.5"></line>
      <line x1={SENSOR.x} y1={SENSOR.y - 10} x2={SENSOR.x} y2={SENSOR.y + 10} stroke="#debd88" stroke-width="1.5"></line>

      <polygon points="39.5,190 48.5,190 44,200" fill="#debd88"></polygon>
      <polygon points="671.5,200 680.5,200 676,190" fill="#debd88"></polygon>

      <g class="loop__label">
        <text x="560" y="118">120 mm radiator</text>
        <text x="400" y="118">Reservoir</text>
        <text x="250" y="118">PWM pump</text>
        <text x={SENSOR.x} y="118">Flow sensor</text>
        <text class="loop__plate-label" x="208" y="228">Inlet</text>
        <text class="loop__plate-label" x="512" y="228">Outlet</text>
        <text class="loop__plate-label loop__heat" x="360" y="421">Heat source under the base, 40 to 100 W</text>
      </g>
    </svg>
  </div>
  <div class="loop__geo" role="group" aria-label="Channel body">
    {
      GEO_IDS.map((g) => (
        <button type="button" data-geo={g} aria-pressed={g === 'straight' ? 'true' : 'false'}>
          {GEO_LABELS[g]}
        </button>
      ))
    }
  </div>
  <dl class="loop__legend">
    <div><dt>Channels</dt><dd data-legend="channels" aria-live="polite" set:html={LEGEND.straight.channels} /></div>
    <div><dt>Flow</dt><dd data-legend="flow" aria-live="polite" set:html={LEGEND.straight.flow} /></div>
    <div><dt>Base</dt><dd>C110 copper, 100 &times; 150 &times; 3 mm</dd></div>
    <div><dt>Loop</dt><dd>Reservoir, PWM pump, Hall-effect flow sensor, cold plate, 120 mm radiator</dd></div>
  </dl>
  <figcaption>
    Schematic of the test loop and channel bodies, not to scale. The flow animation is illustrative, not CFD output.
    <button type="button" class="loop__pause" aria-pressed="false">Pause animation</button>
  </figcaption>
</figure>

<script>
  import { initLoop } from '../scripts/loopFlow';

  document.querySelectorAll<HTMLElement>('.loop').forEach(initLoop);
</script>

<style>
  .loop {
    max-width: 42rem;
    margin: 0;
  }

  .loop__stage {
    position: relative;
    aspect-ratio: 720 / 500;
  }

  .loop[data-view='plate'] .loop__stage {
    aspect-ratio: 504 / 344;
  }

  .loop__cv,
  .loop__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .loop__body {
    display: none;
  }

  .loop[data-geo='straight'] [data-body='straight'],
  .loop[data-geo='serpentine'] [data-body='serpentine'],
  .loop[data-geo='dense'] [data-body='dense'],
  .loop[data-geo='pin'] [data-body='pin'] {
    display: inline;
  }

  .loop__label {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    fill: #fff;
    text-anchor: middle;
  }

  .loop[data-view='plate'] .loop__plate-label {
    font-size: 21px;
  }

  .loop__heat {
    fill: var(--hot);
  }

  .loop__geo {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .loop__geo button {
    min-height: 40px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-ctl);
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 650;
    color: var(--fg);
    cursor: pointer;
    transition:
      border-color var(--t-fast),
      background-color var(--t-fast);
  }

  .loop__geo button:hover {
    border-color: var(--fg);
  }

  .loop__geo button[aria-pressed='true'] {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--black);
  }

  .loop__legend {
    margin: 1rem 0 0;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
  }

  .loop__legend div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .loop__legend dt {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg-muted);
    padding-top: 0.1em;
  }

  .loop__legend dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
  }

  .loop__pause {
    display: inline-block;
    min-height: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    cursor: pointer;
    transition:
      color var(--t-fast),
      text-decoration-color var(--t-fast);
  }

  .loop__pause:hover {
    color: var(--link-hover);
    text-decoration-color: currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .loop__pause {
      display: none;
    }
  }
</style>
