---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TestLoop from '../components/TestLoop.astro';
import ProjectEntry from '../components/ProjectEntry.astro';
import Geometries from '../components/Geometries.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config.mjs';
import { experience, education, focus, skills, sideBuilds } from '../data/profile';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const flagship = projects.find((p) => p.data.flagship);
const others = projects.filter((p) => p !== flagship);
---

<Base>
  <section class="hero on-black">
    <div class="wrap">
      <h1 class="hero__name">Henry dos&nbsp;Santos</h1>
      <div class="hero__grid">
      <div class="hero__text">
        <p class="hero__lead">I design, build, and test liquid cooling hardware for high-heat-flux electronics.</p>
        <p class="hero__sub">
          Mechanical engineering student at Georgia Tech (BSME, expected May 2029) and GT-STAR Fellow in Prof.
          Yogendra Joshi's METTL lab. I'm looking for a thermal or mechanical engineering internship.
        </p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={`mailto:${site.email}`}><Icon name="mail" />Email me</a>
          <a class="btn" href={site.linkedin} rel="me noopener"><Icon name="linkedin" />LinkedIn</a>
          <a class="btn" href={site.github} rel="me noopener"><Icon name="github" />GitHub</a>
          {
            site.resume && (
              <a class="btn" href="/Henry-dos-Santos-Resume.pdf"><Icon name="file" />Resume (PDF)</a>
            )
          }
        </div>
      </div>
      <div class="hero__fig">
        <TestLoop />
      </div>
      </div>
    </div>
  </section>

  <section class="section section--projects" id="projects" aria-labelledby="projects-h">
    <div class="wrap">
      <h2 id="projects-h">Projects</h2>
      {
        flagship && (
          <ProjectEntry
            entry={flagship}
            metricsCaption="Measured on the straight-channel baseline"
            metricsNote="One run per condition (n = 1). Heater power is a setpoint, not a measurement."
          >
            <Geometries compact slot="extra" />
          </ProjectEntry>
        )
      }
      <ul class="pj-list">
        {others.map((entry) => <ProjectEntry entry={entry} />)}
      </ul>

      <h3 class="side__h">Side builds</h3>
      <ul class="side">
        {
          sideBuilds.map((s) => (
            <li>
              <p>
                <strong>{s.title}.</strong> {s.text} <span class="muted">{s.tag}.</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--exp on-tint" id="experience" aria-labelledby="experience-h">
    <div class="wrap">
      <h2 id="experience-h">Experience</h2>
      <div class="exp">
        <ol class="exp__list">
          {
            experience.map((e) => (
              <li class="exp__item">
                <p class="exp__when num">{e.period}</p>
                <div>
                  <h3 class="exp__role">{e.role}</h3>
                  <p class="exp__org">{e.org}</p>
                  {e.detail && <p class="exp__detail">{e.detail}</p>}
                  <ul class="exp__pts">
                    {e.points.map((p) => (
                      <li>{p.href ? <a href={p.href}>{p.text}</a> : p.text}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
        <aside class="edu" aria-labelledby="edu-h">
          <h3 id="edu-h">Education</h3>
          <p class="edu__school">{education.school}</p>
          <p>{education.degree}</p>
          <p>{education.expected}</p>
          <dl class="edu__dl">
            <div>
              <dt>Georgia Tech GPA</dt>
              <dd>
                {
                  site.gpa ? (
                    <span class="num">{site.gpa}</span>
                  ) : (
                    <span class="edu__pending">Pending. Fall 2026 final grades have not posted.</span>
                  )
                }
              </dd>
            </div>
            <div>
              <dt>Transfer</dt>
              <dd>{education.transfer}</dd>
            </div>
            <div>
              <dt>Affiliations</dt>
              <dd>{education.affiliations.join(', ')}</dd>
            </div>
            <div>
              <dt>Focus</dt>
              <dd>{focus.primary} {focus.open}</dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--skills" id="skills" aria-labelledby="skills-h">
    <div class="wrap">
      <h2 id="skills-h">Skills</h2>
      <dl class="sk">
        {
          skills.map((s) => (
            <div class="sk__row">
              <dt>{s.group}</dt>
              <dd>{s.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="contact on-gold" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <h2 id="contact-h">Contact</h2>
      <p class="contact__lead">For internship opportunities, or technical questions about any project here, email me.</p>
      <a class="contact__mail" href={`mailto:${site.email}`}>{site.email}</a>
      <p class="contact__links">
        <a href={site.linkedin} rel="me noopener">linkedin.com/in/henry-dossantos</a>
        <a href={site.github} rel="me noopener">github.com/Henry-dosSantos</a>
        {site.resume && <a href="/Henry-dos-Santos-Resume.pdf">Resume (PDF)</a>}
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(3.5rem, 8vw, 6rem) clamp(3.5rem, 7vw, 5.5rem);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
  }

  @media (min-width: 1040px) {
    .hero__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .hero__name {
    font-size: clamp(2.6rem, 7.5vw, 4.75rem);
    font-weight: 800;
    font-stretch: 122%;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .hero__lead {
    max-width: 30ch;
    margin-top: 0;
    text-wrap: balance;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
  }

  .hero__sub {
    max-width: 56ch;
    margin-top: 1rem;
    color: var(--fg-muted);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .section--projects {
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }

  .section--exp {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .section--skills {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pj-list {
    margin-top: 3rem;
  }

  .side__h {
    margin-top: 3.5rem;
    font-size: 1.15rem;
    font-weight: 750;
  }

  .side {
    margin-top: 0.9rem;
  }

  .side li {
    max-width: 75ch;
    padding-block: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .exp {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .exp {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
  }

  .exp__item {
    display: grid;
    gap: 0.4rem 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }

  .exp__item:first-child {
    padding-top: 0;
  }

  @media (min-width: 640px) {
    .exp__item {
      grid-template-columns: 10.5rem 1fr;
    }
  }

  .exp__when {
    padding-top: 0.3rem;
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .exp__org {
    margin-top: 0.3rem;
    font-weight: 700;
  }

  .exp__detail {
    font-size: 0.9375rem;
    color: var(--fg-muted);
  }

  .exp__pts {
    margin-top: 0.7rem;
    padding-left: 1.2rem;
    list-style: disc;
  }

  .exp__pts li {
    padding-block: 0.15rem;
  }

  .exp__pts li::marker {
    color: var(--fg-muted);
  }

  .edu {
    padding-top: 1.25rem;
    border-top: 2px solid var(--fg);
  }

  @media (min-width: 980px) {
    .edu {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }

  .edu__school {
    margin-top: 0.7rem;
    font-size: 1.15rem;
    font-weight: 750;
    line-height: 1.25;
  }

  .edu__dl {
    margin: 1.2rem 0 0;
    border-top: 1px solid var(--line);
  }

  .edu__dl div {
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
  }

  .edu__dl div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .edu__dl dt {
    font-size: 0.875rem;
    font-weight: 650;
    color: var(--fg-muted);
  }

  .edu__dl dd {
    margin: 0.2rem 0 0;
    font-size: 0.9375rem;
  }

  .edu__pending {
    font-weight: 650;
    color: var(--heat);
  }

  .sk {
    margin: 0;
  }

  .sk__row {
    display: grid;
    gap: 0.25rem 2rem;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 760px) {
    .sk__row {
      grid-template-columns: 14rem 1fr;
    }
  }

  .sk__row dt {
    font-weight: 650;
  }

  .sk__row dd {
    margin: 0;
  }

  .contact {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
  }

  .contact__lead {
    max-width: 44ch;
    margin-top: 1rem;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .contact__mail {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: clamp(1.4rem, 4.4vw, 2.6rem);
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.02em;
    line-height: 1.1;
    overflow-wrap: anywhere;
    text-decoration-thickness: 2px;
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: 1.75rem;
  }
</style>
