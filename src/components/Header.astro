---
import Icon from './Icon.astro';
import { site } from '../site.config.mjs';

const links = [
  { href: '/#projects', label: 'Projects', sm: true },
  { href: '/#experience', label: 'Experience', sm: true },
  { href: '/#skills', label: 'Skills', sm: false },
  { href: '/#contact', label: 'Contact', sm: true },
];
---

<header class="hdr on-navy">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href="/" aria-label={`${site.name}, home`}>
      <span class="hdr__mark"><Icon name="mark" /></span>
      <span class="hdr__name">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="hdr__nav">
        {
          links.map((l) => (
            <li class:list={[!l.sm && 'hdr__lg']}>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    view-transition-name: site-header;
  }

  .hdr__in {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .hdr__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    font-weight: 700;
    font-stretch: 110%;
  }

  .hdr__brand:hover {
    color: var(--fg);
  }

  .hdr__mark {
    width: 30px;
    height: 30px;
    flex: none;
  }

  .hdr__nav {
    display: flex;
    align-items: center;
    gap: clamp(0.25rem, 1.6vw, 1.1rem);
  }

  .hdr__nav a {
    display: inline-block;
    padding: 0.55rem 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    color: var(--fg-muted);
  }

  .hdr__nav a:hover {
    color: var(--fg);
    text-decoration: underline;
  }

  @media (max-width: 560px) {
    .hdr__name,
    .hdr__lg {
      display: none;
    }
  }
</style>
