---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Figure from '../../components/Figure.astro';
import Callout from '../../components/Callout.astro';
import Finding from '../../components/Finding.astro';
import Icon from '../../components/Icon.astro';
import { repoUrl } from '../../site.config.mjs';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return all.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { entry, prev, next } = Astro.props;
const { data, id } = entry;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const repo = repoUrl(data.repo);
const meta = [
  { k: 'Context', v: data.context },
  { k: 'Period', v: data.period },
  ...(data.role ? [{ k: 'My role', v: data.role }] : []),
];
---

<Base title={data.shortTitle} description={data.summary}>
  <article>
    <header class="ph">
      <div class="wrap">
        <a class="mono ph__back" href="/#projects"><span class="arrow arrow--back">&larr;</span> All projects</a>
        <p class="ph__badge"><span class={`badge badge--${data.status}`}>{data.statusLabel}</span></p>
        <h1 class="ph__title" style={`view-transition-name:title-${id}`}>{data.title}</h1>
        <p class="ph__sum">{data.summary}</p>
        <dl class="ph__meta">
          {
            meta.map((m) => (
              <div>
                <dt class="mono">{m.k}</dt>
                <dd>{m.v}</dd>
              </div>
            ))
          }
          {
            data.tools.length > 0 && (
              <div class="ph__tools">
                <dt class="mono">Tools and methods</dt>
                <dd>
                  <ul class="chips">
                    {data.tools.map((t) => <li class="chip">{t}</li>)}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
        {
          repo && (
            <p class="ph__repo">
              <a class="btn" href={repo} rel="noopener"><Icon name="github" />Repository</a>
            </p>
          )
        }
        {
          data.metrics.length > 0 && (
            <dl class="ph__metrics">
              {data.metrics.map((m) => (
                <div>
                  <dd class="num">
                    {m.value}
                    {m.unit && <span>{m.unit}</span>}
                  </dd>
                  <dt>{m.label}</dt>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </header>

    <div class="wrap pb">
      {
        toc.length > 1 && (
          <nav class="toc" aria-label="On this page">
            <p class="mono toc__h">On this page</p>
            <ol>
              {toc.map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <Content components={{ Figure, Callout, Finding }} />
      </div>
    </div>

    <nav class="wrap pn" aria-label="More projects">
      {
        prev ? (
          <a class="pn__a" href={`/projects/${prev.id}/`}>
            <span class="mono">&larr; Previous</span>
            <span class="pn__t">{prev.data.shortTitle}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pn__a pn__a--next" href={`/projects/${next.id}/`}>
            <span class="mono">Next &rarr;</span>
            <span class="pn__t">{next.data.shortTitle}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .ph {
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--line);
    background: radial-gradient(56rem 30rem at 92% -20%, rgb(0 76 151 / 0.3), transparent 70%);
  }

  .ph__back {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--muted);
    text-decoration: none;
  }

  .ph__back:hover .arrow--back {
    transform: translateX(-4px);
  }

  .ph__badge {
    margin-top: 1.6rem;
  }

  .ph__title {
    margin-top: 1rem;
    max-width: 22ch;
    font-size: clamp(2rem, 5.4vw, 3.9rem);
    font-weight: 820;
    font-stretch: 120%;
    line-height: 0.98;
    letter-spacing: -0.03em;
  }

  .ph__sum {
    margin-top: 1.3rem;
    max-width: 62ch;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.45;
    color: #c9d6e3;
  }

  .ph__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.2rem 2rem;
    margin: 2rem 0 0;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
  }

  .ph__meta dt {
    color: var(--gold);
    font-size: 0.6875rem;
  }

  .ph__meta dd {
    margin: 0.3rem 0 0;
    font-size: 0.95rem;
  }

  .ph__tools {
    grid-column: 1 / -1;
  }

  .ph__tools dd {
    margin-top: 0.5rem;
  }

  .ph__repo {
    margin-top: 1.6rem;
  }

  .ph__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    margin: 2.2rem 0 0;
    border-top: 1px solid var(--line-strong);
  }

  .ph__metrics div {
    padding: 1.2rem 1.25rem 0 0;
  }

  .ph__metrics dd {
    margin: 0;
    font-size: clamp(1.6rem, 2.7vw, 2.15rem);
    font-weight: 850;
    font-stretch: 122%;
    letter-spacing: -0.03em;
    line-height: 1;
    white-space: nowrap;
    color: var(--gold-light);
  }

  .ph__metrics dd span {
    margin-left: 0.35em;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--muted);
  }

  .ph__metrics dt {
    margin-top: 0.55rem;
    max-width: 28ch;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .pb {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  @media (min-width: 1080px) {
    .pb {
      grid-template-columns: 15rem minmax(0, 50rem);
    }

    .toc {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
    }
  }

  .toc__h {
    color: var(--gold);
    margin-bottom: 0.7rem;
  }

  .toc ol {
    display: grid;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    padding: 0.35rem 0 0.35rem 1rem;
    margin-left: -1px;
    border-left: 1px solid transparent;
    font-size: 0.9rem;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--text);
    border-left-color: var(--gold);
  }

  .pn {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding-block: 0 clamp(3rem, 7vw, 5rem);
  }

  .pn__a {
    display: grid;
    gap: 0.4rem;
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    transition:
      border-color 0.3s,
      background-color 0.3s,
      transform 0.3s var(--ease);
  }

  .pn__a:hover {
    border-color: var(--line-strong);
    background: rgb(10 40 71 / 0.6);
    transform: translateY(-2px);
  }

  .pn__a--next {
    text-align: right;
    grid-column: 2;
  }

  .pn__a .mono {
    color: var(--gold);
  }

  .pn__t {
    font-weight: 700;
    font-stretch: 108%;
    line-height: 1.25;
  }

  @media (max-width: 560px) {
    .pn {
      grid-template-columns: 1fr;
    }

    .pn__a--next {
      grid-column: 1;
    }

    .pn > span {
      display: none;
    }
  }
</style>
