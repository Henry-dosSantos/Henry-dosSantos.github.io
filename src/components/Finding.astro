---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="fd">
  <h3 class="fd__title">{title}</h3>
  <div class="fd__body"><slot /></div>
</section>

<style>
  .fd {
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }

  .fd:last-of-type {
    border-bottom: 1px solid var(--line);
  }

  .fd__title {
    margin: 0 0 0.45rem;
    font-size: 1.15rem;
    font-stretch: 106%;
    font-weight: 700;
    line-height: 1.25;
  }

  .fd__body {
    max-width: var(--measure);
  }

  .fd__body :global(> * + *) {
    margin-top: 0.6rem;
  }
</style>
