---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="wrap nf">
    <h1>That page does not exist.</h1>
    <p class="muted">The link may be old, or the project may have moved.</p>
    <p><a class="btn btn--primary" href="/">Back to the home page</a></p>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(5rem, 16vh, 10rem);
  }

  h1 {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    font-stretch: 118%;
  }
</style>
